# HeckSweeper - Terminal roguelite minesweeper
# Play locally or host over SSH

.PHONY: build server run run-server run-ascii clean test test-coverage install release fmt lint deps docker help

# Default target
all: build

# Build the local game client
build:
	@echo "Building HeckSweeper..."
	@go build -o hecksweeper ./cmd/hecksweeper
	@echo "Built: ./hecksweeper"

# Build the SSH server
server:
	@echo "Building HeckSweeper SSH server..."
	@go build -o hecksweeper-server ./cmd/server
	@echo "Built: ./hecksweeper-server"

# Build optimized release binaries
release:
	@echo "Building optimized release binaries..."
	@go build -ldflags="-s -w" -o hecksweeper ./cmd/hecksweeper
	@go build -ldflags="-s -w" -o hecksweeper-server ./cmd/server
	@echo "Built: ./hecksweeper, ./hecksweeper-server"

# Run the local game
run: build
	@./hecksweeper

# Run in ASCII mode
run-ascii: build
	@./hecksweeper -unicode=false

# Run with specific seed
run-seed: build
	@./hecksweeper -seed=42

# Run the SSH server
run-server: server
	@./hecksweeper-server --port 2222

# Run tests
test:
	@echo "Running tests..."
	@go test ./...

# Run tests with verbose output
test-v:
	@go test -v ./...

# Run tests with coverage
test-coverage:
	@go test -cover ./...
	@go test -coverprofile=coverage.out ./...
	@go tool cover -html=coverage.out -o coverage.html
	@echo "Coverage report: coverage.html"

# Install to system
install: release
	@cp hecksweeper /usr/local/bin/
	@cp hecksweeper-server /usr/local/bin/
	@echo "Installed to /usr/local/bin/"

# Build Docker image
docker:
	docker build -t hecksweeper .

# Run Docker container
docker-run: docker
	docker run -p 2222:2222 -v hecksweeper-data:/data hecksweeper

# Clean build artifacts
clean:
	@rm -f hecksweeper hecksweeper-server coverage.out coverage.html
	@echo "Clean"

# Format code
fmt:
	@go fmt ./...

# Lint code
lint:
	@golangci-lint run

# Update dependencies
deps:
	@go get -u ./...
	@go mod tidy

# Cross-compile for all platforms
cross:
	@echo "Building for Linux amd64..."
	@GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o dist/hecksweeper-linux-amd64 ./cmd/hecksweeper
	@GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o dist/hecksweeper-server-linux-amd64 ./cmd/server
	@echo "Building for macOS amd64..."
	@GOOS=darwin GOARCH=amd64 go build -ldflags="-s -w" -o dist/hecksweeper-darwin-amd64 ./cmd/hecksweeper
	@echo "Building for macOS arm64..."
	@GOOS=darwin GOARCH=arm64 go build -ldflags="-s -w" -o dist/hecksweeper-darwin-arm64 ./cmd/hecksweeper
	@echo "Building for Windows..."
	@GOOS=windows GOARCH=amd64 go build -ldflags="-s -w" -o dist/hecksweeper-windows-amd64.exe ./cmd/hecksweeper
	@echo "Built all targets in dist/"

# Show help
help:
	@echo "HeckSweeper - Terminal Roguelite Minesweeper"
	@echo ""
	@echo "Play:"
	@echo "  make run          - Play locally"
	@echo "  make run-server   - Start SSH server (ssh -p 2222 localhost)"
	@echo ""
	@echo "Build:"
	@echo "  make build        - Build local client"
	@echo "  make server       - Build SSH server"
	@echo "  make release      - Build optimized binaries"
	@echo "  make docker       - Build Docker image"
	@echo "  make cross        - Cross-compile for all platforms"
	@echo ""
	@echo "Test:"
	@echo "  make test         - Run tests"
	@echo "  make test-v       - Run tests (verbose)"
	@echo "  make test-coverage - Run tests with coverage report"
	@echo ""
	@echo "Other:"
	@echo "  make clean        - Remove build artifacts"
	@echo "  make fmt          - Format code"
	@echo "  make install      - Install to /usr/local/bin"
